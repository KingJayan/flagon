<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.flagon</groupId>
    <artifactId>flagon-parent</artifactId>
    <version>0.9.2-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bundle-app</artifactId>
  <name>Flagon :: Your Application</name>
  <description>Compiles the jar in vendor/ to a browser bundle.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <flagon.bundle.mainClass>dev.flagon.app.AppMain</flagon.bundle.mainClass>
    <flagon.bundle.catalogClass>dev.flagon.app.AppCatalog</flagon.bundle.catalogClass>
    <flagon.bundle.name>app</flagon.bundle.name>
    <flagon.app.jar>${maven.multiModuleProjectDirectory}/vendor/app.jar</flagon.app.jar>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>platform-browser</artifactId>
    </dependency>
    <!-- supplies org.lwjgl.* in place of the real thing the jar was built against -->
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>lwjgl-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>socket-classlib</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>reflect-policy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- reads the jar at build time to write the entry point; never reaches the bundle -->
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>app-entry</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- the jar from vendor/, installed by the root pom before this module is built -->
    <dependency>
      <groupId>dev.flagon.vendor</groupId>
      <artifactId>app</artifactId>
      <version>LOCAL</version>
    </dependency>

    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- asks the jar what its main class is and writes the call to it. an ordinary call, so
           the compiler can follow it into the application -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>write-entry-point</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>dev.flagon.appentry.WriteAppEntry</mainClass>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>${flagon.app.jar}</argument>
                <argument>${project.build.directory}/generated-sources/app</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>compile-entry-point</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/app</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
