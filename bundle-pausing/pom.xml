<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.flagon</groupId>
    <artifactId>flagon-parent</artifactId>
    <version>0.9.3-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bundle-pausing</artifactId>
  <name>Flagon :: Pausing Bundle</name>
  <description>This module compiles a small WebAssembly bundle that runs code that can pause while it loads.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <flagon.bundle.mainClass>dev.flagon.pausing.PausingMain</flagon.bundle.mainClass>
    <flagon.bundle.catalogClass>dev.flagon.pausing.PausingCatalog</flagon.bundle.catalogClass>
    <flagon.bundle.name>pausing</flagon.bundle.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>platform-browser</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>resource-pack</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- only the webassembly loader sets up strings before a thread exists -->
    <profile>
      <id>js</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>write-catalog</id>
                <phase>none</phase>
              </execution>
              <execution>
                <id>write-resource-pack</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-bundle</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
