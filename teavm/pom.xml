<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.flagon</groupId>
    <artifactId>flagon-parent</artifactId>
    <version>0.9.3-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <groupId>org.teavm</groupId>
  <artifactId>teavm-core</artifactId>
  <version>0.15.0-flagon</version>
  <name>Flagon :: TeaVM Core</name>
  <description>This module rebuilds teavm-core 0.15.0 with the compiler and classlib fixes that Flagon needs.</description>

  <properties>
    <checkstyle.skip>true</checkstyle.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-interop</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-metaprogramming-api</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-extension-apis</artifactId>
      <version>${teavm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-extension-spi</artifactId>
      <version>${teavm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-relocated-libs-asm-commons</artifactId>
      <version>${teavm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-relocated-libs-asm-util</artifactId>
      <version>${teavm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-relocated-libs-hppc</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-relocated-libs-rhino</artifactId>
      <version>${teavm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-teavm-core</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.teavm</groupId>
                  <artifactId>teavm-core</artifactId>
                  <version>${teavm.version}</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <excludes>META-INF/**,org/teavm/backend/wasm/model/instruction/WasmTypeInference*.class,org/teavm/backend/wasm/transformation/CoroutineTransformation*.class,org/teavm/backend/javascript/intrinsics/reflection/ClassInfoGenerator.class,org/teavm/backend/javascript/codegen/DefaultAliasProvider.class,org/teavm/backend/javascript/intrinsics/reflection/ClassReflectionInfoGenerator*.class,org/teavm/backend/wasm/generate/methods/WasmGCInstructionGenerationVisitor*.class,org/teavm/backend/wasm/intrinsics/reflection/ReflectionMetadataGenerator*.class,org/teavm/runtime/Fiber*.class,org/teavm/backend/wasm/transformation/CoroutineFunctions*.class,org/teavm/backend/wasm/dependencies/WasmGCDependencies*.class</excludes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
