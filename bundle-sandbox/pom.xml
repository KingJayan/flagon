<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.flagon</groupId>
    <artifactId>flagon-parent</artifactId>
    <version>0.9.3-SNAPSHOT</version>
  </parent>

  <artifactId>bundle-sandbox</artifactId>
  <name>Flagon :: Sandbox Bundle</name>
  <description>Compiles the runtime plus diagnostic programs to a browser bundle.</description>

  <properties>
    <!-- a bundle is an artifact of this repository, not something downstream consumes -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <flagon.bundle.mainClass>dev.flagon.sandbox.SandboxMain</flagon.bundle.mainClass>
    <flagon.bundle.catalogClass>dev.flagon.sandbox.SandboxCatalog</flagon.bundle.catalogClass>
    <flagon.bundle.name>sandbox</flagon.bundle.name>
    <!-- the half of the reflection opt-in that names classes it cannot annotate -->
    <flagon.reflect.classes>dev.flagon.sandbox.ReflectedBy*</flagon.reflect.classes>
    <flagon.reflect.proxies>dev.flagon.sandbox.Proxied</flagon.reflect.proxies>
    <flagon.reflect.constructed>${project.basedir}/src/main/reflect/constructed.txt</flagon.reflect.constructed>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>platform-browser</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>lwjgl2-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>lwjgl3-compat</artifactId>
    </dependency>

    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>socket-classlib</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>jdk-classlib</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>concurrent-classlib</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>reflect-policy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.flagon</groupId>
      <artifactId>jdk-shims</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
