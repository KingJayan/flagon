<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.flagon</groupId>
  <artifactId>flagon-parent</artifactId>
  <version>0.9.2-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Flagon</name>
  <description>A desktop Java/LWJGL compatibility environment for the browser.</description>

  <modules>
    <module>platform-api</module>
    <module>platform-browser</module>
    <module>runtime</module>
    <module>socket-classlib</module>
    <module>lwjgl-compat</module>
    <module>bundle-sandbox</module>
    <module>example-app</module>
    <module>bundle-example</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <teavm.version>0.15.0</teavm.version>
    <junit.version>5.11.4</junit.version>
    <lwjgl.version>2.9.3</lwjgl.version>
    <!-- comp backend for browser bundles: WEBASSEMBLY_GC or JAVASCRIPT. build with -Pjs for
         the latter; see docs/ARCHITECTURE.md "Backend selection" -->
    <flagon.target>WEBASSEMBLY_GC</flagon.target>
    <flagon.bundle.extension>wasm</flagon.bundle.extension>
    <flagon.optimization>SIMPLE</flagon.optimization>
    <!-- what -Prelease optimizes at, per backend: see the release profile -->
    <flagon.optimization.release>FULL</flagon.optimization.release>
    <flagon.minify>false</flagon.minify>
    <!-- strict adds null/bounds checks so java exceptions are thrown instead of js TypeErrors -->
    <flagon.strict>true</flagon.strict>
    <flagon.sourceMaps>true</flagon.sourceMaps>
    <!-- where browser bundles are emitted for the web shell to serve. -->
    <flagon.bundleOutput>${maven.multiModuleProjectDirectory}/web/public/flagon</flagon.bundleOutput>
  </properties>

  <!-- consumed by downstream repositories; see docs/DOWNSTREAM.md for details. release workflow sets
       the version from the tag, so this stays a snapshot of the next release between them-->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/KingJayan/flagon</url>
    </repository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>platform-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>platform-browser</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>lwjgl-compat</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso-apis</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-platform</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-classlib</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-core</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>write-catalog</id>
              <phase>prepare-package</phase>
              <goals>
                <goal>java</goal>
              </goals>
              <configuration>
                <mainClass>${flagon.bundle.catalogClass}</mainClass>
                <arguments>
                  <argument>${flagon.bundleOutput}/${flagon.bundle.name}.catalog.json</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-maven-plugin</artifactId>
          <version>${teavm.version}</version>
          <executions>
            <execution>
              <id>compile-bundle</id>
              <goals>
                <goal>compile</goal>
              </goals>
              <configuration>
                <mainClass>${flagon.bundle.mainClass}</mainClass>
                <targetType>${flagon.target}</targetType>
                <targetDirectory>${flagon.bundleOutput}</targetDirectory>
                <targetFileName>${flagon.bundle.name}.${flagon.bundle.extension}</targetFileName>
                <jsModuleType>ES2015</jsModuleType>
                <optimizationLevel>${flagon.optimization}</optimizationLevel>
                <minifying>${flagon.minify}</minifying>
                <sourceMapsGenerated>${flagon.sourceMaps}</sourceMapsGenerated>
                <debugInformationGenerated>${flagon.sourceMaps}</debugInformationGenerated>
                <stopOnErrors>true</stopOnErrors>
                <strict>${flagon.strict}</strict>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-wasm-runtime</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.teavm</groupId>
                  <artifactId>teavm-core</artifactId>
                  <version>${teavm.version}</version>
                  <includes>org/teavm/backend/wasm/wasm-gc-module-runtime.js</includes>
                  <outputDirectory>${project.build.directory}/wasm-runtime</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-wasm-runtime</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${flagon.bundleOutput}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/wasm-runtime/org/teavm/backend/wasm</directory>
                  <includes>
                    <include>wasm-gc-module-runtime.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>js</id>
      <properties>
        <flagon.target>JAVASCRIPT</flagon.target>
        <flagon.bundle.extension>js</flagon.bundle.extension>
        <!-- teavm 0.15 miscompiles this backend's async bridges at FULL, and a bundle minified out
             of SIMPLE is the smaller of the two anyway -->
        <flagon.optimization.release>SIMPLE</flagon.optimization.release>
      </properties>
    </profile>

    <!-- what a hosted build ships: optimized and minified, with no maps or debug information
         beside it. strict stays on, exception semantics being behaviour and not a debugging aid -->
    <profile>
      <id>release</id>
      <properties>
        <flagon.optimization>${flagon.optimization.release}</flagon.optimization>
        <flagon.minify>true</flagon.minify>
        <flagon.sourceMaps>false</flagon.sourceMaps>
      </properties>
    </profile>
  </profiles>
</project>
