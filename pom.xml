<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.flagon</groupId>
  <artifactId>flagon-parent</artifactId>
  <version>0.9.3-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Flagon</name>
  <description>Flagon runs a desktop Java or LWJGL application in a browser.</description>

  <modules>
    <module>platform-api</module>
    <module>platform-browser</module>
    <module>runtime</module>
    <module>toolchain/socket-classlib</module>
    <module>toolchain/jdk-classlib</module>
    <module>toolchain/nio-classlib</module>
    <module>toolchain/awt-classlib</module>
    <module>toolchain/sound-classlib</module>
    <module>toolchain/crypto-classlib</module>
    <module>toolchain/concurrent-classlib</module>
    <module>toolchain/reflect-policy</module>
    <module>toolchain/jdk-shims</module>
    <module>toolchain/app-entry</module>
    <module>toolchain/resource-pack</module>
    <module>lwjgl-core</module>
    <module>lwjgl2-compat</module>
    <module>lwjgl3-compat</module>
    <module>bundle-sandbox</module>
    <module>examples/app</module>
    <module>examples/thirdparty</module>
    <module>examples/bundle</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <teavm.version>0.15.0</teavm.version>
    <junit.version>5.11.4</junit.version>
    <lwjgl.version>2.9.3</lwjgl.version>
    <lwjgl3.version>3.3.3</lwjgl3.version>

    <flagon.target>WEBASSEMBLY_GC</flagon.target>
    <flagon.bundle.extension>wasm</flagon.bundle.extension>
    <flagon.optimization>SIMPLE</flagon.optimization>

    <flagon.optimization.release>FULL</flagon.optimization.release>
    <flagon.minify>false</flagon.minify>

    <flagon.strict>true</flagon.strict>
    <flagon.sourceMaps>true</flagon.sourceMaps>

    <flagon.reflect.classes></flagon.reflect.classes>

    <flagon.reflect.proxies></flagon.reflect.proxies>

    <flagon.reflect.constructed></flagon.reflect.constructed>

    <flagon.app.dir>${maven.multiModuleProjectDirectory}/vendor</flagon.app.dir>

    <flagon.app.reflect></flagon.app.reflect>
    <flagon.app.jar>${maven.multiModuleProjectDirectory}/target/app.jar</flagon.app.jar>

    <flagon.resources.from>${project.build.outputDirectory}</flagon.resources.from>
    <flagon.bundleOutput>${maven.multiModuleProjectDirectory}/web/public/flagon</flagon.bundleOutput>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/KingJayan/flagon</url>
    </repository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>platform-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>platform-browser</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>lwjgl-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>lwjgl-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>lwjgl2-compat</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.flagon</groupId>
        <artifactId>lwjgl3-compat</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso-apis</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-platform</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-classlib</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-core</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>write-catalog</id>
              <phase>prepare-package</phase>
              <goals>
                <goal>java</goal>
              </goals>
              <configuration>
                <mainClass>${flagon.bundle.catalogClass}</mainClass>
                <arguments>
                  <argument>${flagon.bundleOutput}/${flagon.bundle.name}.catalog.json</argument>
                </arguments>
              </configuration>
            </execution>
            <execution>
              <id>write-resource-pack</id>
              <phase>prepare-package</phase>
              <goals>
                <goal>java</goal>
              </goals>
              <configuration>
                <mainClass>dev.flagon.pack.WriteResourcePack</mainClass>
                <classpathScope>compile</classpathScope>
                <arguments>
                  <argument>${flagon.resources.from}</argument>
                  <argument>${flagon.bundleOutput}/${flagon.bundle.name}.pack</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-maven-plugin</artifactId>
          <version>${teavm.version}</version>
          <executions>
            <execution>
              <id>compile-bundle</id>
              <goals>
                <goal>compile</goal>
              </goals>
              <configuration>
                <mainClass>${flagon.bundle.mainClass}</mainClass>
                <targetType>${flagon.target}</targetType>
                <targetDirectory>${flagon.bundleOutput}</targetDirectory>
                <targetFileName>${flagon.bundle.name}.${flagon.bundle.extension}</targetFileName>
                <jsModuleType>ES2015</jsModuleType>
                <optimizationLevel>${flagon.optimization}</optimizationLevel>
                <minifying>${flagon.minify}</minifying>
                <sourceMapsGenerated>${flagon.sourceMaps}</sourceMapsGenerated>
                <debugInformationGenerated>${flagon.sourceMaps}</debugInformationGenerated>
                <stopOnErrors>true</stopOnErrors>
                <strict>${flagon.strict}</strict>
                <properties>
                  <flagon.reflect.classes>${flagon.reflect.classes}</flagon.reflect.classes>
                  <flagon.reflect.proxies>${flagon.reflect.proxies}</flagon.reflect.proxies>
                  <flagon.reflect.constructed>${flagon.reflect.constructed}</flagon.reflect.constructed>
                </properties>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>10.21.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/toolchain/checkstyle/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>check-style</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-wasm-runtime</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.teavm</groupId>
                  <artifactId>teavm-core</artifactId>
                  <version>${teavm.version}</version>
                  <includes>org/teavm/backend/wasm/wasm-gc-module-runtime.js</includes>
                  <outputDirectory>${project.build.directory}/wasm-runtime</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-wasm-runtime</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${flagon.bundleOutput}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/wasm-runtime/org/teavm/backend/wasm</directory>
                  <includes>
                    <include>wasm-gc-module-runtime.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>app</id>
      <modules>
        <module>bundle-app</module>
      </modules>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>fold-vendor-jars</id>
                <phase>validate</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete file="${flagon.app.jar}" quiet="true"/>
                    <zip destfile="${flagon.app.jar}" duplicate="preserve" whenempty="create">
                      <zipgroupfileset dir="${flagon.app.dir}" includes="*.jar"/>
                    </zip>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-install-plugin</artifactId>
            <version>3.1.3</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>install-vendor-jar</id>
                <phase>validate</phase>
                <goals>
                  <goal>install-file</goal>
                </goals>
                <configuration>
                  <groupId>dev.flagon.vendor</groupId>
                  <artifactId>app</artifactId>
                  <version>LOCAL</version>
                  <packaging>jar</packaging>
                  <file>${flagon.app.jar}</file>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>js</id>
      <properties>
        <flagon.target>JAVASCRIPT</flagon.target>
        <flagon.bundle.extension>js</flagon.bundle.extension>

        <flagon.optimization.release>SIMPLE</flagon.optimization.release>
      </properties>
    </profile>

    <profile>
      <id>release</id>
      <properties>
        <flagon.optimization>${flagon.optimization.release}</flagon.optimization>
        <flagon.minify>true</flagon.minify>
        <flagon.sourceMaps>false</flagon.sourceMaps>
      </properties>
    </profile>
  </profiles>
</project>
